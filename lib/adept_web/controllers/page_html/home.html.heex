<Layouts.flash_group flash={@flash} />
<div class="min-h-screen bg-gradient-to-br from-indigo-950 via-purple-900 to-indigo-900">
  <div class="max-w-4xl mx-auto px-6 py-24">
    <div class="text-center mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-400/20 text-purple-300 text-sm mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Powered by Arcana
      </div>

      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6 tracking-tight">
        Arcana <span class="text-purple-300">Example</span>
      </h1>
      <p class="text-lg text-purple-200/80 max-w-xl mx-auto leading-relaxed">
        A sample Phoenix app showcasing the Arcana RAG library.
        Semantic search, hybrid retrieval, knowledge graphs, and hallucination grounding.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
        <a
          href="/arcana"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-purple-500 text-white font-medium rounded-lg hover:bg-purple-400 transition-colors shadow-lg shadow-purple-500/25"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
          </svg>
          Open Dashboard
        </a>
        <a
          href="/arcana/ask"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white/10 text-white font-medium rounded-lg border border-white/10 hover:bg-white/15 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zm-4 0H9v2h2V9z" clip-rule="evenodd" />
          </svg>
          Try Ask
        </a>
        <a
          href="https://github.com/georgeguimaraes/arcana"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 text-purple-300 font-medium rounded-lg hover:text-white transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
          </svg>
          Source
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="group rounded-xl p-6 bg-white/5 border border-white/5 hover:border-purple-400/20 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-1">Semantic Search</h3>
        <p class="text-purple-300/70 text-sm">Find documents by meaning with vector embeddings and pgvector.</p>
      </div>

      <div class="group rounded-xl p-6 bg-white/5 border border-white/5 hover:border-purple-400/20 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-400" viewBox="0 0 20 20" fill="currentColor">
            <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-1">Hybrid Retrieval</h3>
        <p class="text-purple-300/70 text-sm">Combine vector similarity with full-text search via reciprocal rank fusion.</p>
      </div>

      <div class="group rounded-xl p-6 bg-white/5 border border-white/5 hover:border-purple-400/20 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M17.778 8.222c-4.296-4.296-11.26-4.296-15.556 0A1 1 0 01.808 6.808c5.076-5.077 13.308-5.077 18.384 0a1 1 0 01-1.414 1.414zM14.95 11.05a7 7 0 00-9.9 0 1 1 0 01-1.414-1.414 9 9 0 0112.728 0 1 1 0 01-1.414 1.414zM12.12 13.88a3 3 0 00-4.242 0 1 1 0 01-1.415-1.415 5 5 0 017.072 0 1 1 0 01-1.415 1.415zM9 16a1 1 0 011-1h.01a1 1 0 110 2H10a1 1 0 01-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-1">Knowledge Graphs</h3>
        <p class="text-purple-300/70 text-sm">Extract entities and relationships, detect communities, enrich retrieval with graph context.</p>
      </div>

      <div class="group rounded-xl p-6 bg-white/5 border border-white/5 hover:border-purple-400/20 transition-colors">
        <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-1">Grounding</h3>
        <p class="text-purple-300/70 text-sm">Detect hallucinations with Hallmark. Sentence-level faithfulness scoring against context.</p>
      </div>
    </div>

    <div class="mt-16 rounded-xl bg-white/5 border border-white/5 p-6 overflow-hidden">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-3 h-3 rounded-full bg-red-400/60"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-400/60"></div>
        <div class="w-3 h-3 rounded-full bg-green-400/60"></div>
        <span class="text-purple-400/50 text-xs ml-2 font-mono">iex</span>
      </div>
      <pre class="text-sm leading-relaxed overflow-x-auto"><code class="text-purple-200"><span class="text-purple-400">alias</span> Arcana.Agent

ctx =
  Agent.new(<span class="text-emerald-400">"How does Elixir handle concurrency?"</span>,
    repo: MyApp.Repo,
    llm: llm
  )
  |> Agent.search()
  |> Agent.rerank()
  |> Agent.answer()
  |> Agent.ground()

ctx.grounding.score        <span class="text-purple-500"># => 0.96</span>
ctx.grounding.hallucinated_spans  <span class="text-purple-500"># => []</span></code></pre>
    </div>
  </div>
</div>
